# --- Firebase (same project as tf360-360 — reuse existing auth) ---
# Copy these from tf360/vendor-web/.env.local
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tf360-360.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tf360-360
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tf360-360.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI Service base URL ---
# Local dev: http://localhost:8080
# Production: https://ai.tf360.com
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8080
